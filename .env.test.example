# Environnement TEST — copier en .env.test (non commité) et renseigner JWT_SIGNING_KEY.
#   docker compose --env-file .env.test -f docker-compose.yml -f docker-compose.test.yml up -d --build

# Aucun port exposé en TEST (MongoDB éphémère, API interne au réseau Compose)

# Base MongoDB
MONGO_DATABASE=smartroute_test

# Environnement ASP.NET Core de l'API (pas de seed, pas de Swagger)
API_ENVIRONMENT=Testing

# Clé de signature JWT : au moins 32 octets aléatoires. Secret : ne jamais la commiter.
JWT_SIGNING_KEY=
