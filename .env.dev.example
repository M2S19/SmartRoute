# Environnement DEV — copier en .env.dev (non commité) et renseigner JWT_SIGNING_KEY.
#   docker compose --env-file .env.dev -f docker-compose.yml -f docker-compose.dev.yml up -d --build

# Port hôte de l'API (port interne du conteneur : toujours 8080)
API_PORT=5000
# Port hôte de MongoDB, lié à 127.0.0.1 uniquement
MONGO_PORT=27017

# Base MongoDB (même base que « dotnet run » en Development)
MONGO_DATABASE=smartroute_dev

# Environnement ASP.NET Core de l'API (Development : seed des comptes de démo + Swagger)
API_ENVIRONMENT=Development

# Clé de signature JWT : au moins 32 octets aléatoires. Secret : ne jamais la commiter.
JWT_SIGNING_KEY=
