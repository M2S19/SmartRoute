{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "smartroute"
  },
  "Jwt": {
    "Issuer": "smartroute-api",
    "Audience": "smartroute-mobile",
    "LifetimeHours": 12
  },
  "Database": {
    "InitializeOnStartup": true
  }
}
