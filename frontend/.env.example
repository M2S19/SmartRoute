# Copier en .env.local (non commité) et adapter. Après modification : recharger l'app (ou npx expo start -c).

# URL de l'API ASP.NET Core, selon la cible. Laisser vide pour la valeur par défaut :
#   - émulateur Android     : http://10.0.2.2:5000   (défaut sur Android)
#   - Expo web / simulateur iOS : http://127.0.0.1:5000 (défaut ailleurs)
#   - Expo Go sur téléphone : http://<IP du PC sur le Wi-Fi>:5000  (obligatoire ; ipconfig pour la trouver)
EXPO_PUBLIC_API_BASE_URL=

# Données simulées (true) ou API réelle (false), par fonctionnalité.
# EXPO_PUBLIC_USE_MOCKS donne la valeur par défaut de toutes les bascules (true si absent).
# Si l'authentification est simulée, le token est factice : ne brancher aucune autre fonctionnalité sur l'API.
EXPO_PUBLIC_USE_MOCKS=true
# Connexion (POST /api/auth/login)
EXPO_PUBLIC_MOCK_AUTH=false
# US1 — optimisation d'une tournée (POST /api/routes/optimize)
EXPO_PUBLIC_MOCK_OPTIMIZE=false
# US3 — tournées du livreur (GET /api/routes/me + PATCH /api/routes/me/{routeId}/stops/{stopId}/deliver)
EXPO_PUBLIC_MOCK_MY_ROUTE=false
# US2 — affectation d'une livraison (assign-best-driver + confirm-assignment)
EXPO_PUBLIC_MOCK_DELIVERIES=false
