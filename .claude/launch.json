{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "web", "--", "--port", "8081"],
      "env": { "EXPO_PUBLIC_API_BASE_URL": "http://127.0.0.1:5000" },
      "port": 8081
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/SmartRoute.Api"],
      "port": 5000,
      "url": "http://127.0.0.1:5000"
    }
  ]
}
