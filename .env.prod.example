# Environnement PROD — copier en .env.prod (non commité) et renseigner JWT_SIGNING_KEY.
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# Port hôte de l'API (port interne du conteneur : toujours 8080). MongoDB n'est pas exposé.
API_PORT=8080

# Base MongoDB
MONGO_DATABASE=smartroute

# Environnement ASP.NET Core de l'API (pas de seed, pas de Swagger)
API_ENVIRONMENT=Production

# Clé de signature JWT : au moins 32 octets aléatoires. Secret : ne jamais la commiter.
# Vide → l'API refuse de démarrer.
JWT_SIGNING_KEY=
